---
// The comic library as a weekly manga magazine: one two-page spread per comic language (ADR 0006).
// The right page is the language's title page, its newest comic's cover printed in colour; the left page is its contents:
// that comic's chapters when the language holds one comic, otherwise its comics, as greyscale panels that print in colour on hover and focus.
// One page per interface locale (/ and /vi/), plus one page per comic language (/language/<code>/, /vi/language/<code>/)
// so a spread's contents can stay ten panels long however many comics a language holds.
// No JavaScript and no inline styles (CSP in public/_headers).
import "../styles/fonts.css";
import "../styles/fonts-magazine.css";
import "../styles/magazine.css";
import "../styles/lettering.css";
import "../styles/library.css";
import BrandHead from "./BrandHead.astro";
import { coverPanel, inlineMarkdown, listComics, SITE, type Comic, type Lettering, type Panel } from "../lib/comic";
import { languageName, libraryPath, LOCALES, UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  /** Show only this comic language, every comic in it. */
  only?: string;
}
const { locale, only } = Astro.props;
const t = UI[locale];
const all = listComics();
const comics = only ? all.filter((c) => (c.config.lang ?? "en") === only) : all;
// Ten panels on a contents page. A language with more comics shows nine and a panel opening the language's own page.
const CONTENTS_LIMIT = 10;

// Group by comic language: the reader's own language first, then the biggest languages.
const byLang = new Map<string, Comic[]>();
for (const c of comics) {
  const lang = c.config.lang ?? "en";
  byLang.set(lang, [...(byLang.get(lang) ?? []), c]);
}
const spreads = [...byLang.entries()].sort(
  ([a, x], [b, y]) => Number(b === locale) - Number(a === locale) || y.length - x.length || a.localeCompare(b),
);
const newest = all[0];
const languages = [...new Set(all.map((c) => c.config.lang ?? "en"))];
const title = only ? `${languageName(only, locale)} · ${t.libraryTitle}` : t.libraryTitle;
const heading = only ? t.languageHeading(languageName(only, only)) : t.libraryHeading;

const img = (comic: Comic, panel: Panel) => `${comic.panelsPath}${panel.id}.webp`;
const panelCount = (comic: Comic) => comic.config.chapters.reduce((n, ch) => n + ch.panels.length, 0);
const counts = (comic: Comic) => `${t.chapters(comic.config.chapters.length)} · ${t.panels(panelCount(comic))}`;
const focusClass = (p?: Panel) => (p?.focus ? `f-${p.focus}` : "");
// A chapter's thumbnail is its first panel, unless that panel is already the comic's cover.
const thumb = (comic: Comic, ch: Comic["config"]["chapters"][number]) =>
  ch.panels.find((p) => p.id !== coverPanel(comic)?.id) ?? ch.panels[0];
// Three panels after the cover and the thumbnails: a taste of the first pages.
const strip = (comic: Comic) => {
  const used = new Set([coverPanel(comic)?.id, ...comic.config.chapters.map((ch) => thumb(comic, ch)?.id)]);
  return comic.config.chapters.flatMap((ch) => ch.panels).filter((p) => !used.has(p.id)).slice(0, 3);
};
// The cover carries the cover panel's first caption or balloon, set in the comic's own lettering.
const coverText = (comic: Comic) => {
  const text = (coverPanel(comic)?.text ?? []).find((x: Lettering) => "cap" in x || "say" in x || "stack" in x);
  if (!text) return "";
  if ("say" in text) return `<p class="bubble cover-say">${inlineMarkdown(text.say)}</p>`;
  return `<p class="cap cover-cap">${inlineMarkdown("cap" in text ? text.cap : "stack" in text ? text.stack[0] : "")}</p>`;
};
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fafaf7">
  <title>{title}</title>
  <meta name="description" content={t.libraryDescription}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={t.libraryDescription}>
  <meta property="og:type" content="website">
  <BrandHead />
  <link rel="canonical" href={new URL(libraryPath(locale, only), SITE).href}>
  {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(libraryPath(l, only), SITE).href}>)}
  <link rel="alternate" type="application/json" href="/content.json" title="Content feed">
</head>
<body class="mag">
  <main class="spreads">
    {spreads.length === 0 && (
      <section class="spread spread-empty">
        <header class="mast">
          <a class="wordmark" href={libraryPath(locale)}>Vibe<span>2</span>Fire</a>
        </header>
        <p class="lib-empty">{t.empty}</p>
      </section>
    )}

    {spreads.map(([lang, list], i) => {
      const lead = list[0];
      const cover = coverPanel(lead);
      const single = list.length === 1;
      const others = (only || list.length <= CONTENTS_LIMIT ? list : list.slice(0, CONTENTS_LIMIT - 1));
      return (
        <section class="spread" id={`lang-${lang}`} aria-labelledby={`title-${lang}`}>
          <div class="leaf-head">
            {i === 0 ? (
              <>
                <header class="mast">
                  <a class="wordmark" href={libraryPath(locale)}>Vibe<span>2</span>Fire</a>
                  <nav class="ui-switch" aria-label={t.interface}>
                    {LOCALES.map((l) => (
                      <a href={libraryPath(l, only)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined}>{l.toUpperCase()}</a>
                    ))}
                  </nav>
                </header>
                <h1 class="headline" set:html={inlineMarkdown(heading)} />
                {(languages.length > 1 || only) && (
                  <nav class="lang-tabs" aria-label={t.filterBy}>
                    {only && <a href={libraryPath(locale)}>{t.allLanguages}</a>}
                    {languages.map((l) => (
                      <a href={only ? libraryPath(locale, l) : `#lang-${l}`} lang={l} aria-current={l === only ? "page" : undefined}>
                        {languageName(l, l)} <b>{all.filter((c) => (c.config.lang ?? "en") === l).length}</b>
                      </a>
                    ))}
                  </nav>
                )}
              </>
            ) : (
              <p class="running-head"><span>Vibe2Fire</span> {t.contents}</p>
            )}
          </div>

          <ol class="contents" role="list" aria-label={`${t.contents} · ${languageName(lang, locale)}`} lang={lead.config.lang ?? "en"}>
            {single
              ? lead.config.chapters.map((ch, n) => (
                  <li>
                    <a class="cell" href={`${lead.path}#${ch.id}`} aria-label={t.chapterLink(n + 1, ch.title)}>
                      <img class={focusClass(thumb(lead, ch))} src={img(lead, thumb(lead, ch))} alt="" width="600" height="400" loading="lazy" decoding="async">
                      <span class="num" aria-hidden="true">{n + 1}</span>
                      <span class="cell-title" aria-hidden="true">{ch.title}</span>
                    </a>
                  </li>
                ))
              : others.map((comic, n) => (
                  <li>
                    <a class="cell" href={comic.path} lang={comic.config.lang ?? "en"}>
                      {coverPanel(comic) && <img class={focusClass(coverPanel(comic))} src={img(comic, coverPanel(comic)!)} alt="" width="600" height="400" loading="lazy" decoding="async">}
                      <span class="num" aria-hidden="true">{n + 1}</span>
                      <span class="cell-title">{comic.config.title}</span>
                    </a>
                  </li>
                ))}
            {!single && !only && list.length > CONTENTS_LIMIT && (
              <li><a class="cell cell-more" href={libraryPath(locale, lang)}>{t.allIn(list.length, languageName(lang, locale))}</a></li>
            )}
          </ol>

          <div class="title-page">
            <header class="lang-head">
              <h2 id={`title-${lang}`} lang={lang}>{languageName(lang, lang)}</h2>
              <p lang={locale}>{lang !== locale && <>{languageName(lang, locale)} · </>}{t.comics(list.length)}</p>
            </header>
            <a class={`cover lettering-${lead.lettering}`} href={lead.path} lang={lead.config.lang ?? "en"} aria-labelledby={`comic-${lead.slug}`}>
              {cover && <img class={focusClass(cover)} src={img(lead, cover)} alt="" width="1536" height="1024" decoding="async" fetchpriority={i === 0 ? "high" : undefined} loading={i === 0 ? undefined : "lazy"}>}
              <Fragment set:html={coverText(lead)} />
              {lead === newest && <span class="burst" lang={locale}>{t.newest}</span>}
            </a>
            <div class="title-box">
              <h3 id={`comic-${lead.slug}`}><a href={lead.path} lang={lead.config.lang ?? "en"}>{lead.config.title}</a></h3>
              <p class="meta" lang={locale}>{counts(lead)}</p>
              {lead.config.summary && <p class="summary" lang={lead.config.lang ?? "en"} set:html={inlineMarkdown(lead.config.summary)} />}
              <p class="credit" lang={locale}>{t.credit}</p>
            </div>
            {strip(lead).length > 0 && (
              <a class="strip" href={`${lead.path}#${lead.config.chapters[0]?.id ?? ""}`} aria-label={`${t.startReading}: ${lead.config.title}`}>
                {strip(lead).map((p) => <img class={focusClass(p)} src={img(lead, p)} alt="" width="600" height="400" loading="lazy" decoding="async">)}
              </a>
            )}
          </div>

          {i === spreads.length - 1 && (
            <footer class="folio">
              <p>{t.aiNotice} {t.colophon}</p>
              <a href="/content.json">content.json</a>
            </footer>
          )}
        </section>
      );
    })}
  </main>
</body>
</html>
