---
// The comic library, a weekly manga magazine's front section (ADR 0006): a masthead, a filter bar by comic language,
// the newest comic as the issue's feature, then the catalogue: every comic in the current filter as a card, newest first.
// Filtering is a set of static pages, so it needs no JavaScript and every filter has its own URL:
// / and /vi/ show every language; /language/<code>/ and /vi/language/<code>/ show one.
// No JavaScript and no inline styles (CSP in public/_headers).
import "../styles/fonts.css";
import "../styles/fonts-magazine.css";
import "../styles/magazine.css";
import "../styles/lettering.css";
import "../styles/library.css";
import BrandHead from "./BrandHead.astro";
import { coverPanel, inlineMarkdown, listComics, SITE, type Comic, type Lettering, type Panel } from "../lib/comic";
import { languageName, libraryPath, LOCALES, UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  /** Filter to this comic language. */
  only?: string;
}
const { locale, only } = Astro.props;
const t = UI[locale];
const all = listComics();
const langOf = (c: Comic) => c.config.lang ?? "en";
const comics = only ? all.filter((c) => langOf(c) === only) : all;

// Filter choices: the reader's own language first, then the biggest languages.
const counts = new Map<string, number>();
for (const c of all) counts.set(langOf(c), (counts.get(langOf(c)) ?? 0) + 1);
const languages = [...counts.keys()].sort((a, b) => Number(b === locale) - Number(a === locale) || counts.get(b)! - counts.get(a)! || a.localeCompare(b));

const feature = comics[0];
const newest = all[0];
const choice = only ? languageName(only, locale) : t.filterAll;
const title = only ? `${languageName(only, locale)} · ${t.libraryTitle}` : t.libraryTitle;
const heading = only ? t.languageHeading(languageName(only, locale)) : t.libraryHeading;

const img = (comic: Comic, panel: Panel) => `${comic.panelsPath}${panel.id}.webp`;
const panelCount = (comic: Comic) => comic.config.chapters.reduce((n, ch) => n + ch.panels.length, 0);
const focusClass = (p?: Panel) => (p?.focus ? `f-${p.focus}` : "");
const dateFormat = new Intl.DateTimeFormat(locale, { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });
const released = (comic: Comic) => (comic.config.date ? dateFormat.format(new Date(`${comic.config.date}T00:00:00Z`)) : "");
const meta = (comic: Comic) =>
  [languageName(langOf(comic), locale), t.chapters(comic.config.chapters.length), released(comic)].filter(Boolean).join(" · ");
// Three panels after the cover: a taste of the first pages.
const strip = (comic: Comic) => comic.config.chapters.flatMap((ch) => ch.panels).filter((p) => p.id !== coverPanel(comic)?.id).slice(0, 3);
// The cover carries the cover panel's first caption or balloon, set in the comic's own lettering.
const coverText = (comic: Comic) => {
  const text = (coverPanel(comic)?.text ?? []).find((x: Lettering) => "cap" in x || "say" in x || "stack" in x);
  if (!text) return "";
  if ("say" in text) return `<p class="bubble cover-say">${inlineMarkdown(text.say)}</p>`;
  return `<p class="cap cover-cap">${inlineMarkdown("cap" in text ? text.cap : "stack" in text ? text.stack[0] : "")}</p>`;
};
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#fafaf7">
  <title>{title}</title>
  <meta name="description" content={t.libraryDescription}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={t.libraryDescription}>
  <meta property="og:type" content="website">
  <BrandHead />
  <link rel="canonical" href={new URL(libraryPath(locale, only), SITE).href}>
  {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={new URL(libraryPath(l, only), SITE).href}>)}
  <link rel="alternate" type="application/json" href="/content.json" title="Content feed">
</head>
<body class="mag">
  <header class="lib-mast">
    <div class="mast">
      <a class="wordmark" href={libraryPath(locale)}>Vibe<span>2</span>Fire</a>
      <nav class="ui-switch" aria-label={t.interface}>
        {LOCALES.map((l) => (
          <a href={libraryPath(l, only)} hreflang={l} lang={l} aria-current={l === locale ? "page" : undefined}>{l.toUpperCase()}</a>
        ))}
      </nav>
    </div>
    <h1 class="headline" set:html={inlineMarkdown(heading)} />
    <p class="lead">{t.libraryDescription}</p>
  </header>

  <nav class="filter" aria-label={t.filterBy}>
    <span class="filter-label">{t.filterBy}</span>
    <a href={libraryPath(locale)} aria-current={only ? undefined : "page"}>{t.filterAll} <b>{all.length}</b></a>
    {languages.map((l) => (
      <a href={libraryPath(locale, l)} lang={l} aria-current={l === only ? "page" : undefined}>{languageName(l, l)} <b>{counts.get(l)}</b></a>
    ))}
  </nav>

  <main>
    {feature ? (
      <section class="feature" aria-labelledby="feature-title">
        <a class={`cover lettering-${feature.lettering}`} href={feature.path} lang={langOf(feature)} tabindex="-1" aria-hidden="true">
          {coverPanel(feature) && <img class={focusClass(coverPanel(feature))} src={img(feature, coverPanel(feature)!)} alt="" width="1536" height="1024" decoding="async" fetchpriority="high">}
          <Fragment set:html={coverText(feature)} />
          {feature === newest && <span class="burst" lang={locale}>{t.newest}</span>}
        </a>
        <div class="feature-text">
          <h2 id="feature-title"><a href={feature.path} lang={langOf(feature)}>{feature.config.title}</a></h2>
          <p class="meta">{meta(feature)} · {t.panels(panelCount(feature))}</p>
          {feature.config.summary && <p class="summary" lang={langOf(feature)} set:html={inlineMarkdown(feature.config.summary)} />}
          <p class="credit">{t.credit}</p>
          <a class="read" href={feature.path}>{t.read}</a>
          {strip(feature).length > 0 && (
            <a class="strip" href={`${feature.path}#${feature.config.chapters[0]?.id ?? ""}`} aria-label={`${t.startReading}: ${feature.config.title}`}>
              {strip(feature).map((p) => <img class={focusClass(p)} src={img(feature, p)} alt="" width="600" height="400" loading="lazy" decoding="async">)}
            </a>
          )}
        </div>
      </section>
    ) : (
      <p class="lib-empty">{t.empty}</p>
    )}

    {comics.length > 0 && (
      <section class="catalogue" aria-labelledby="catalogue-title">
        <header class="catalogue-head">
          <h2 id="catalogue-title">{t.catalogue(choice)}</h2>
          <p>{t.comics(comics.length)}</p>
        </header>
        <ol class="cards" role="list">
          {comics.map((comic, n) => (
            <li>
              <a class="card" href={comic.path}>
                <span class="card-art">
                  {coverPanel(comic) && <img class={focusClass(coverPanel(comic))} src={img(comic, coverPanel(comic)!)} alt="" width="600" height="400" loading="lazy" decoding="async">}
                  <span class="num" aria-hidden="true">{n + 1}</span>
                  {comic === newest && <span class="burst" lang={locale}>{t.newest}</span>}
                </span>
                <span class="card-text">
                  <b class="card-title" lang={langOf(comic)}>{comic.config.title}</b>
                  <span class="card-meta">{meta(comic)}</span>
                  {comic.config.summary && <span class="card-summary" lang={langOf(comic)} set:html={inlineMarkdown(comic.config.summary)} />}
                </span>
              </a>
            </li>
          ))}
        </ol>
      </section>
    )}
  </main>

  <footer class="folio">
    <p>{t.aiNotice} {t.colophon}</p>
    <a href="/content.json">content.json</a>
  </footer>
</body>
</html>
