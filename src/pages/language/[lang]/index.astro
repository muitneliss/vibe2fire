---
import type { GetStaticPaths } from "astro";
import Library from "../../../components/Library.astro";
import { listComics } from "../../../lib/comic";
import { DEFAULT_LOCALE } from "../../../lib/i18n";

// Every comic in one language, English chrome.
export const getStaticPaths = (() =>
  [...new Set(listComics().map((c) => c.config.lang ?? "en"))].map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;
---
<Library locale={DEFAULT_LOCALE} only={Astro.params.lang} />
