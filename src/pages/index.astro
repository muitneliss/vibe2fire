---
import ComicPage from "../components/ComicPage.astro";
import { listComics } from "../lib/comic";

// The home comic (home: true in its comic.yaml) is the front page.
const home = listComics().find((c) => c.config.home);
if (!home) throw new Error("no comic has home: true in comics/*/comic.yaml");
---
<ComicPage comic={home} />
