---
import type { GetStaticPaths } from "astro";
import ComicPage from "../../components/ComicPage.astro";
import { listComics, type Comic } from "../../lib/comic";

// Every other comic lives at /<slug>/.
export const getStaticPaths = (() =>
  listComics()
    .filter((comic) => !comic.config.home)
    .map((comic) => ({ params: { slug: comic.slug }, props: { comic } }))) satisfies GetStaticPaths;

const { comic } = Astro.props as { comic: Comic };
---
<ComicPage comic={comic} />
