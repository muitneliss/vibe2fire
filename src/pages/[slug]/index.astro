---
import type { GetStaticPaths } from "astro";
import ComicPage from "../../components/ComicPage.astro";
import { listComics, type Comic } from "../../lib/comic";

// Every comic lives at /<slug>/; the library at / lists them.
export const getStaticPaths = (() =>
  listComics().map((comic) => ({ params: { slug: comic.slug }, props: { comic } }))) satisfies GetStaticPaths;

const { comic } = Astro.props as { comic: Comic };
---
<ComicPage comic={comic} />
