{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Astro build served by Workers static assets, behind HTTP Basic Auth enforced by src/worker.ts (ADR 0007).
  "main": "src/worker.ts",
  "name": "vibe2fire",
  "account_id": "bb1360f1b1f5d7234c323287ec170d15",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "vibe2fire.dev", "custom_domain": true }],
  "workers_dev": true,
  // Mirrors the dashboard's Observability settings so a deploy does not reset them.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true,
    },
  },
}
