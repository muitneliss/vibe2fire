{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Astro build served by Workers static assets; no Worker script.
  "name": "vibe2fire",
  "account_id": "bb1360f1b1f5d7234c323287ec170d15",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "routes": [{ "pattern": "vibe2fire.dev", "custom_domain": true }],
  "workers_dev": true,
}
